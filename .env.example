# Copy to .env at the repo root. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5443/meridian_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5443/meridian_test
PORT=4000
# The web dev server listens on this origin's port; the API only accepts browser writes from it.
WEB_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=168
NODE_ENV=development
